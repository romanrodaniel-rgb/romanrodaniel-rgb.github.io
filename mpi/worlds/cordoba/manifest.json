{
  "format": "semantic-sound-world/2",
  "id": "cordoba",
  "name": "Córdoba",
  "version": "1.20.2-public",
  "description": "Mundo sonoro intermodal de Córdoba: cartografía relacional, imágenes propias y registro sonoro navegable.",
  "method": "Coordenadas y relaciones precalculadas; la demostración pública preserva la topología sin publicar la fuente bibliográfica completa.",
  "dimensions": 3,
  "files": {
    "nodes": "nodes.json",
    "coordinates": "coordinates/umap-3d.json",
    "neighbors": "neighbors.json",
    "relations": "relations.json",
    "sonification": "sonification.json",
    "projections": {
      "umap": "coordinates/umap-3d.json",
      "tsne": "coordinates/tsne-3d.json",
      "pca": "coordinates/pca-3d.json"
    }
  },
  "rendering": {
    "labelNeighborCount": 0,
    "visibleRelationLimit": 0,
    "visibleRouteLimit": 36,
    "hoverThrottleMs": 70,
    "progressiveThreshold": 3000,
    "chunkSize": 1000,
    "auto2DThreshold": 1400,
    "showLinksDefault": false,
    "colorModeDefault": "relation-hierarchy",
    "viewModeDefault": "3d",
    "showAxesDefault": true,
    "activeGroupLimit": 20,
    "qualityDefault": "balanced",
    "thumbnailMaxEdge": 384,
    "visibleImageLimit": 10,
    "imageCacheReleaseMs": 3500
  },
  "scales": {
    "territorial": "region",
    "documentary": "node-type",
    "sonic": "audio-node-and-relations"
  },
  "audio": {
    "count": 1,
    "maxVoices": 6,
    "cacheSize": 8
  },
  "defaultProjection": "umap"
}
